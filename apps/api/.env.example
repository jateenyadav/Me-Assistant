# Copy to .env and fill in. NEVER commit .env.
PORT=4000

# MongoDB — local (mongodb://127.0.0.1:27017/lifeos) or an Atlas SRV string
MONGODB_URI=mongodb://127.0.0.1:27017/lifeos

# JWT access-token secret — generate a strong random value, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET=change-me-access
JWT_ACCESS_TTL=15m
# Refresh tokens are opaque + hashed at rest (not JWTs); only their lifetime is configured.
JWT_REFRESH_TTL=7d

# CORS origin for the web app (Next.js dev)
WEB_ORIGIN=http://localhost:3000
