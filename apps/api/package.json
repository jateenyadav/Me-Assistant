{
  "name": "@lifeos/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "test:google": "pnpm build && node --test scripts/google-auth-test.cjs",
    "test:finance": "pnpm build && node --test scripts/finance-test.cjs",
    "test:life": "pnpm build && node --test scripts/life-test.cjs",
    "test:catalog": "pnpm build && node --test scripts/catalog-test.cjs",
    "test:mcp": "pnpm build && node --test scripts/mcp-test.cjs",
    "test:ai": "pnpm build && node --test scripts/ai-test.cjs",
    "test:smoke": "pnpm build && node scripts/auth-smoke.cjs"
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.11",
    "@langchain/aws": "1.4.5",
    "@langchain/core": "1.2.12",
    "@langchain/google-genai": "2.3.2",
    "@langchain/openai": "1.5.13",
    "@lifeos/shared": "workspace:*",
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@nestjs/common": "12.0.3",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "12.0.3",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.0.3",
    "bcrypt": "6.0.0",
    "google-auth-library": "11.1.0",
    "mongoose": "9.10.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.3",
    "@nestjs/testing": "12.0.3",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/node": "22.10.2",
    "@types/passport-jwt": "4.0.1",
    "jest": "30.0.0",
    "ts-jest": "29.2.5",
    "typescript": "5.9.2"
  }
}
